# ─── Required ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
APP_SECRET=your_secure_random_secret_here

# ─── Optional (for cloud sync feature) ───────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

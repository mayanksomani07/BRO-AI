{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "baseUrl": "",
    "paths": {
      "@/*": ["src/*"],
      "@screens/*": ["src/screens/*"],
      "@engine/*": ["src/engine/*"],
      "@store/*": ["src/store/*"],
      "@components/*": ["src/components/*"],
      "@api/*": ["src/api/*"],
      "@db/*": ["src/db/*"],
      "@i18n/*": ["src/i18n/*"],
      "@constants/*": ["src/constants/*"]
    }
  },
  "include": ["src", "App.tsx", "babel.config.js", "metro.config.js"]
}